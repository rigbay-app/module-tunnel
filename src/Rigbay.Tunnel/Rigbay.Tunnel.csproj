<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone module repository. The host contract is the git submodule external/rigbay (pinned to a commit of
    https://github.com/rigbay-app/rigbay); nothing is published as a package. Clone with the recurse-submodules option.
    Rigbay.Abstractions.dll must NOT end up in the output folder: the host supplies its own copy.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Rigbay.Tunnel</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rigbay.Tunnel.Tests" />
    <InternalsVisibleTo Include="Rigbay.Tunnel.Demo" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\rigbay\src\Rigbay.Abstractions\Rigbay.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <None Include="..\..\module.json" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
    <!-- the module's icon (manifest field "icon"): the tile, the quiet glyph and the unsupported tile sit next to module.json -->
    <None Include="..\..\icon*.svg" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
    <None Include="lang\*.lang" CopyToOutputDirectory="PreserveNewest" LinkBase="lang" />
  </ItemGroup>

</Project>
